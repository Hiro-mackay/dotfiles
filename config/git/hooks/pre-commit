#!/usr/bin/env zsh
#
# Repository pre-commit hook. core.hooksPath points here (set by home-manager
# activation, modules/home/default.nix).

set -e

# --- git-secrets scan (MUST stay first) ---
# Block commits that contain the machine-local private identity. Prohibited
# patterns live in this repo's local git config (registered from
# ~/.gitconfig.local by home-manager activation) and are never tracked.
# No-op on machines where git-secrets is not installed.
if git secrets --list >/dev/null 2>&1; then
    git secrets --pre_commit_hook -- "$@"
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"

# --- AGENTS.md SSoT sync ---
# config/agents/AGENTS.md is the single source for global instructions. Codex
# does not follow file symlinks, so config/codex/AGENTS.md stays a byte-identical
# real-file copy. One-directional.
AGENTS_SRC="${REPO_ROOT}/config/agents/AGENTS.md"
AGENTS_DST="${REPO_ROOT}/config/codex/AGENTS.md"
if [[ -f "${AGENTS_SRC}" ]] && ! diff -q "${AGENTS_SRC}" "${AGENTS_DST}" >/dev/null 2>&1; then
    cp "${AGENTS_SRC}" "${AGENTS_DST}"
    git add "config/codex/AGENTS.md"
    echo "pre-commit: synced config/codex/AGENTS.md from config/agents/AGENTS.md"
fi

# --- VS Code extension drift warning (advisory only, never blocks) ---
# The extensions list is restored by `nix run .#switch`. VS Code has no hook for
# extension changes, so warn when the list has drifted from what is installed.
VSCODE_EXTENSIONS="${REPO_ROOT}/config/vscode/extensions"
if command -v code >/dev/null 2>&1 && [[ -f "${VSCODE_EXTENSIONS}" ]]; then
    installed="$(code --list-extensions 2>/dev/null | sort || true)"
    if [[ -n "${installed}" ]] && ! diff -q <(print -r -- "${installed}") "${VSCODE_EXTENSIONS}" >/dev/null 2>&1; then
        echo "pre-commit: VS Code extensions drifted from ${VSCODE_EXTENSIONS}; run 'codeexport' to update." >&2
    fi
fi
