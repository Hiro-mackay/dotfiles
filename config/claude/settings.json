{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PONYTAIL_SUBAGENT_MATCHER": "^(general-purpose|claude)$",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "permissions": {
    "deny": [
      "Bash(sudo:*)",
      "Bash(git reset:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(**/secrets/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/script/statusline.sh"
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "ponytail@ponytail": true,
    "figma@synced": false,
    "design@synced": false,
    "cowork-plugin-management@synced": false
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "language": "ja",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5": {}
  },
  "advisorModel": "fable",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "preferredNotifChannel": "terminal_bell",
  "remoteControlAtStartup": false,
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "skillOverrides": {
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:skill-creator": "off",
    "codebase-memory": "off",
    "graphify": "off",
    "critique": "off"
  }
}
