#!/usr/bin/env bash
# ⌘L: rename the focused tab and, in a Claude session tab, the session too, so the tab
# bar, the sidebar and ⌘P show the same name.
set -euo pipefail
pane=${HERDR_ACTIVE_PANE_ID:?} tab=${HERDR_ACTIVE_TAB_ID:?}
# The popup closes when this script exits, so hold it open long enough to read why.
fail() {
  printf '%s\n' "$1" >&2
  read -r -s -n 1 -p '(press a key)' || true
  exit 1
}
read -e -r -p 'name › ' name
[[ -n $name ]] || exit 0
herdr tab rename "$tab" "$name" >/dev/null || fail "renaming the tab failed"
id=$(herdr agent list | jq -r --arg p "$pane" 'first(.result.agents[] | select(.pane_id == $p) | .tokens.session // empty) // empty')
[[ -n $id ]] || exit 0
# Typed keys reach Claude only while herdr-claude-tab has it attached; its idle screen
# would take the Enter as "resume".
pgrep -f "^claude attach $id\$" >/dev/null || fail "renamed the tab only: press enter in it to resume the session, then rename again"
herdr pane send-text "$pane" "/rename $name" >/dev/null
herdr pane send-keys "$pane" enter >/dev/null
