# Git accounts on this machine. The dotfiles switch creates this file once, if it is
# missing; after that it is yours to edit and is never overwritten or tracked.

# Base account
[user]
	name = mackay
	email = 43330841+Hiro-mackay@users.noreply.github.com

# Another account for some repositories: uncomment one condition, fill it in, and put
# that account's [user] in ~/.gitconfig.local.
#
# By directory:
# [includeIf "gitdir/i:<directory>/"]
# 	path = ~/.gitconfig.local
#
# By remote URL:
# [includeIf "hasconfig:remote.*.url:<url-pattern>"]
# 	path = ~/.gitconfig.local
#
# A different SSH key for some remotes (a Host alias in ~/.ssh/config). Unconditional,
# so it also applies when cloning over SSH, before the repository exists:
#
# [url "git@<host-alias>:<owner>/"]
# 	insteadOf = git@github.com:<owner>/

# Strings the dotfiles repo must never contain (its pre-commit hook rejects them),
# e.g. another account's email domain or a name that must stay private:
#
# [secrets]
# 	patterns = <name>
# 	patterns = @<domain>

# Sign commits with an SSH key:
#
# [gpg]
# 	format = ssh
# [user]
# 	signingkey = ~/.ssh/id_ed25519.pub
# [commit]
# 	gpgsign = true
