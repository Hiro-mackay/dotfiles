#!/usr/bin/env bash
# ⌘W: in a Claude session tab, stop the session. Claude keeps the conversation, ⌘P
# lists it as sleeping and wakes it when opened, and herdr-claude-tab closes the tab
# once the process is gone. Anywhere else, close the pane.
set -euo pipefail
pane=${HERDR_ACTIVE_PANE_ID:?}
id=$(herdr agent list | jq -r --arg p "$pane" 'first(.result.agents[] | select(.pane_id == $p) | .tokens.session // empty) // empty')
if [[ -z $id ]]; then
  herdr pane close "$pane" >/dev/null
else
  out=$(claude stop "$id" 2>&1) || herdr notification show "not stopped" --body "$out" >/dev/null
fi
