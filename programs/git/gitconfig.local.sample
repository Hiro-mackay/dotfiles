# Optional machine-local git settings, for a machine that needs more than the base
# account in programs/git (another account, signing keys, ...). Copy, then keep only
# what this machine needs; never commit the copy:
#
#   cp ~/.dotfiles/programs/git/gitconfig.local.sample ~/.gitconfig.local
#
# Everything below is commented out, so an untouched copy changes nothing.

# Another account for one organization's repositories, e.g. on a work machine.
# Put the account in its own untracked file:
#
# [includeIf "gitdir/i:~/Repository/github.com/<org>/"]
# 	path = ~/.gitconfig.<org>
#
# ~/.gitconfig.<org>:
# [user]
# 	name = <name>
# 	email = <email>
#
# With a separate SSH key for that organization (Host github.com-<org> in
# ~/.ssh/config). Kept here rather than in ~/.gitconfig.<org> so it also applies when
# cloning over SSH (`ghq get -p`), before the repository directory exists:
#
# [url "git@github.com-<org>:<org>/"]
# 	insteadOf = git@github.com:<org>/

# Strings the dotfiles repo must never contain (its pre-commit hook rejects them),
# e.g. a work email domain or an organization name. One pattern per line:
#
# [secrets]
# 	patterns = <org-name>
# 	patterns = @<work-domain>

# Sign commits with an SSH key:
#
# [gpg]
# 	format = ssh
# [user]
# 	signingkey = ~/.ssh/id_ed25519.pub
# [commit]
# 	gpgsign = true
