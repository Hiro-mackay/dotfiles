# ⌘-keys drive herdr (programs/herdr): each sends the Alt-key that herdr binds to the
# action, as ESC + key, the encoding every terminal parser reads as one Alt-key.
keybind = super+n=text:\x1bn
keybind = super+p=text:\x1bp
keybind = super+b=text:\x1bb
keybind = super+t=text:\x1bt
keybind = super+o=text:\x1bo
keybind = super+d=text:\x1bv
keybind = super+w=text:\x1bx
keybind = super+shift+g=text:\x1by
keybind = super+shift+arrow_left=text:\x1bh
keybind = super+shift+arrow_right=text:\x1bl
keybind = super+shift+arrow_down=text:\x1bj
keybind = super+shift+arrow_up=text:\x1bk
keybind = super+j=text:\x1bs
keybind = super+semicolon=text:\x1b;
keybind = super+shift+bracket_right=text:\x1bw
keybind = super+shift+bracket_left=text:\x1bq
keybind = super+digit_1=text:\x1b1
keybind = super+digit_2=text:\x1b2
keybind = super+digit_3=text:\x1b3
keybind = super+digit_4=text:\x1b4
keybind = super+digit_5=text:\x1b5
keybind = super+digit_6=text:\x1b6
keybind = super+digit_7=text:\x1b7
keybind = super+digit_8=text:\x1b8
keybind = super+digit_9=text:\x1b9
