#!/usr/bin/env bash
# ⌘P: start a Claude session, or list every one as agent view does, grouped by what
# needs you first. A task typed at the "new" prompt starts a session (herdr-new-claude);
# Enter on an empty prompt goes to the selected session's tab, opening one (which wakes
# a sleeping session) when it has none. Ctrl+F switches the prompt to filtering the
# list, and Ctrl+X deletes the selected session.
set -euo pipefail
self=$0 here=$(dirname "$0")
note=${TMPDIR:-/tmp}/herdr-claude-pick.note
cursor=${TMPDIR:-/tmp}/herdr-claude-pick.cursor
c() { printf '\033[38;2;%sm%s\033[0m' "$1" "$2"; }
dim=142\;142\;142
new='new › ' find='find › '

if command -v tac >/dev/null; then reverse=(tac); else reverse=(tail -r); fi

# Claude's last reply, from the transcript Claude Code keeps per session.
last_reply() {
  local f
  f=$HOME/.claude/projects/$(printf '%s' "$2" | sed 's#[/.]#-#g')/$1.jsonl
  [[ -f $f ]] || f=$(ls "$HOME"/.claude/projects/*/"$1".jsonl 2>/dev/null | head -n 1)
  [[ -f $f ]] || return 0
  "${reverse[@]}" "$f" | grep -m 50 -F '"type":"assistant"' |
    jq -r 'first(.message.content[]? | select(.type == "text") | .text)' 2>/dev/null | grep -m 1 -v '^null$' || true
}

case ${1:-} in
--list)
  # \x1f, not a tab: read collapses empty fields between whitespace separators.
  claude agents --json --all | jq -r '[.[] | select(.id)] | sort_by(-.startedAt)[]
    | [.id, .state, (.pid // "" | tostring), (.sessionId // ""), (.cwd // ""), (.name // .id)]
    | join("\u001f")' |
    while IFS=$'\x1f' read -r id st pid sid cwd name; do
      if [[ -z $pid ]] || ! kill -0 "$pid" 2>/dev/null; then st=sleeping; fi
      case $st in blocked) rank=1 ;; working) rank=2 ;; sleeping) rank=4 ;; *) rank=3 ;; esac
      printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\n' "$rank" "$st" "$id" "$sid" "$cwd" "$name"
    done | sort -t $'\x1f' -k1,1n -s |
    while IFS=$'\x1f' read -r rank st id sid cwd name; do
      case $st in
        blocked) icon=$(c 254\;253\;194 ◐) group='Needs input' ;;
        working) icon=$(c 180\;250\;114 ●) group=Working ;;
        failed) icon=$(c 255\;130\;114 ✗) group=Completed ;;
        sleeping) icon=$(c "$dim" ∙) group=Sleeping ;;
        *) icon=✻ group=Completed ;;
      esac
      if [[ $group != "${last:-}" ]]; then
        [[ -z ${last:-} ]] || printf -- '-\t \n'
        printf -- '-\t %s\n' "$(c "$dim" "$group")"
      fi
      last=$group
      reply=$(last_reply "$sid" "$cwd")
      summary=$(grep -m 1 '^result:' <<<"$reply" | sed 's/^result: *//') || true
      [[ -n $summary ]] || summary=$(grep -m 1 -v '^[[:space:]]*$' <<<"$reply" || true)
      pad=$((32 - $(printf '%s' "$name" | wc -L 2>/dev/null || printf '%s' "$name" | wc -m)))
      ((pad > 0)) || pad=1
      repo=${cwd%%/.claude/worktrees/*}
      repo=${repo##*/}
      printf '%s\t %s %s%*s%s  %s\n' "$id" "$icon" "$name" "$pad" '' "$(c 189\;189\;189 "$(printf '%-16s' "$repo")")" "$(c "$dim" "$summary")"
    done
  exit ;;
--rm)
  [[ $2 != - ]] || exit 0
  claude rm "$2" >"$note" 2>&1 || true
  exit ;;
--enter)
  if [[ $FZF_PROMPT == "$new" && -n $2 ]]; then
    printf 'become(exec %q {q})\n' "$here/herdr-new-claude"
  elif [[ $3 != - ]]; then
    echo accept
  fi
  exit ;;
--find)
  if [[ $FZF_PROMPT == "$new" ]]; then
    echo "enable-search+change-prompt($find)"
  else
    echo "clear-query+disable-search+change-prompt($new)+reload($self --list)"
  fi
  exit ;;
--skip)
  # Group headings and gaps are rows too, as fzf has no unselectable rows: when the
  # cursor lands on one, keep going the way it came.
  prev=$(cat "$cursor" 2>/dev/null || echo -1)
  echo "$2" >"$cursor"
  [[ ${3:-} == - ]] || exit 0
  if (($2 == 0 || $2 > prev)); then echo down; else echo up; fi
  exit ;;
--header)
  printf ' %s\n ' "$(cat "$note" 2>/dev/null || echo 'enter new or open · ^f find · ^x delete')"
  exit ;;
esac

rm -f "$note" "$cursor"
# FZF_DEFAULT_OPTS from the shell's fzf setup (--height=40% --border) would shrink the popup.
picked=$("$self" --list | FZF_DEFAULT_OPTS= fzf --ansi --delimiter '\t' --with-nth 2 --no-sort --layout reverse \
  --disabled --prompt "$new" --pointer '▌' --info inline-right --no-scrollbar --highlight-line --header "$("$self" --header)" \
  --color 'fg:#ffffff,fg+:#ffffff,bg+:#1f1f1f,hl:#00c2ff,hl+:#00c2ff,prompt:#00c2ff,pointer:#00c2ff,header:#8e8e8e,info:#8e8e8e,border:#1f1f1f,gutter:-1' \
  --bind 'load:pos(2)+unbind(load)' \
  --bind "focus:transform($self --skip {n} {1})" \
  --bind "enter:transform($self --enter {q} {1})" \
  --bind "ctrl-f:transform($self --find)" \
  --bind "ctrl-x:execute-silent($self --rm {1})+reload($self --list)+transform-header($self --header)") || exit 0
# Empty when herdr-new-claude took fzf's place.
[[ -n $picked ]] || exit 0
id=${picked%%$'\t'*}
tab=$(herdr agent list | jq -r --arg i "$id" 'first(.result.agents[] | select(.tokens.session == $i) | .tab_id) // empty')
if [[ -n $tab ]]; then
  herdr tab focus "$tab" >/dev/null
else
  "$here/herdr-claude-open" "$id" >/dev/null
fi
