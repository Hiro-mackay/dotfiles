#!/usr/bin/env bash
# Prompt for a task and start Claude on it in a new tab of the "claude" workspace.
# "name: task" starts it in the directory mapped to name in ~/.config/herdr/claude-dirs
# (name=path per line); otherwise it starts in the focused pane's directory. "name:"
# alone starts Claude with no task.
set -euo pipefail
dirs_file=${XDG_CONFIG_HOME:-$HOME/.config}/herdr/claude-dirs
# The popup closes when this script exits, so hold it open long enough to read why.
fail() {
  printf '%s\n' "$1" >&2
  read -r -s -n 1 -p '(press a key)' || true
  exit 1
}
read -e -r -p 'claude › ' input
[[ -n $input ]] || exit 0
cwd=${HERDR_ACTIVE_PANE_CWD:-$HOME} prompt=$input
if [[ $input =~ ^([a-z0-9_-]+):[[:space:]]*(.*)$ && -r $dirs_file ]]; then
  dir=$(awk -F= -v k="${BASH_REMATCH[1]}" '$1 == k { print substr($0, length(k) + 2); exit }' "$dirs_file")
  if [[ -n $dir ]]; then
    cwd=${dir/#\~/$HOME} prompt=${BASH_REMATCH[2]}
  fi
fi
cd "$cwd" || fail "cannot enter $cwd"
args=()
[[ -z $prompt ]] || args+=("$prompt")
out=$(claude --bg ${args[@]+"${args[@]}"} 2>&1) || fail "claude --bg failed: $out"
id=$(sed -n 's/^backgrounded · \([0-9a-f]*\) · .*/\1/p' <<<"$out")
[[ -n $id ]] || fail "claude --bg printed no session id: $out"
"$(dirname "$0")/herdr-claude-open" "$id" >/dev/null || fail "opening a tab for $id failed"
