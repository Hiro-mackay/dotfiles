{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  // This file uses JSON with comments (JSONC).
  // Uncomment and edit any setting to make it file-managed.
  // Remove a setting to fall back to the value saved in Settings.
  // cmux creates this template on launch when ~/.config/cmux/cmux.json is missing.
  // Legacy settings.json files are read only as fallback for keys not present here.

  // dark-daltonized is the Claude Code theme (see config/claude/settings.json),
  // so keep cmux's own appearance in sync rather than following system light/dark.
  "app": {
    "appearance": "dark",
    // Keep browsing/light editing/AI-diff review inside cmux rather than
    // handing off to an external editor (VSCode is reserved for real work).
    "openSupportedFilesInCmux": true,
    "openMarkdownInCmuxViewer": true,
    "preferredEditor": ""
  },

  "fileEditor": {
    "wordWrap": true
  },

  "fileExplorer": {
    // "defaultEditor" opens the OS-default app for the file type (VSCode, in
    // practice) -- the opposite of what we want. "preview" is cmux's own
    // built-in viewer/editor, which is what keeps things inside cmux.
    "doubleClickAction": "preview"
  },

  "diffViewer": {
    // Side-by-side (VSCode-style) instead of unified -- easier to scan AI diffs.
    "defaultLayout": "split"
  },

  "terminal": {
    // Heavy multi-agent/subagent usage (see config/claude hooks) means many
    // terminals accumulate; hibernate idle ones instead of leaving them all live.
    "agentHibernation": {
      "enabled": true,
      "maxLiveTerminals": 8,
      "idleSeconds": 300
    },
    "autoResumeAgentSessions": false,
    // Focusing the TextBox also shows it (per cmux docs), which is exactly
    // the custom input-area UI we don't want -- force both off so new
    // terminals get the plain shell prompt.
    "focusTextBoxOnNewTerminals": false,
    "showTextBoxOnNewTerminals": false,
    "textBoxSubmitActions": [
      {
        "systemImage": "sparkle",
        "kind": "commandTemplate",
        "commandTemplate": "claude -- {{prompt}}",
        "id": "claude",
        "title": "Claude",
        "backgroundColorHex": "#F6D5C8",
        "assetName": "AgentIcons\/Claude"
      },
      {
        "systemImage": "sparkle",
        "kind": "commandTemplate",
        "commandTemplate": "claude --dangerously-skip-permissions -- {{prompt}}",
        "id": "claude-dangerous",
        "title": "Claude Dangerous",
        "backgroundColorHex": "#F6D5C8",
        "assetName": "AgentIcons\/Claude"
      },
      {
        // config/codex/config.toml sets approval_policy = "on-request", so codex
        // manages its own approvals via hooks -- no --yolo here.
        "title": "Codex",
        "commandTemplate" : "codex -- {{prompt}}",
        "systemImage" : "sparkles",
        "assetName" : "AgentIcons\/Codex",
        "id" : "codex",
        "backgroundColorHex" : "#8FDBFF",
        "kind" : "commandTemplate"
      }
    ]
  },

  "automation": {
    // Only claude/codex CLIs are configured in this dotfiles repo; the rest
    // (cursor/gemini/kiro/amp) aren't in use, so keep their integrations off.
    "claudeCodeIntegration": true,
    "cursorIntegration": false,
    "geminiIntegration": false,
    "kiroIntegration": false,
    "ampIntegration": false,
    // Notifications are consolidated on cmux's side, not Claude Code's own
    // Stop/Notification hooks -- let cmux surface subagent activity.
    "suppressSubagentNotifications": false
  },

  "shortcuts": {
    "bindings": {
      // Default is ctrl+cmd+shift+d. ctrl+cmd+d didn't fire in practice --
      // likely swallowed by macOS's system-wide Look Up (Ctrl+Cmd+D)
      // shortcut before it reaches cmux. opt+cmd+d isn't a cmux default
      // binding (cmd+d is splitRight, ctrl+opt+cmd+d is toggleBrowserDesignMode).
      "openDiffViewer": "opt+cmd+d"
    }
  },

  "sidebar": {
    "watchGitStatus": true,
    "showBranchDirectory": true,
    // Org policy requires the PR workflow for all changes to main/master,
    // so PR visibility in the sidebar matters here.
    "showPullRequests": true,
    "makePullRequestsClickable": true,
    "openPullRequestLinksInCmuxBrowser": true,
    "showAgentActivity": true,
    "showProgress": true
  },

