# Machine-local git settings: accounts and anything specific to this machine.
# Never commit the copy. On a personal machine, copying is all it takes:
#
#   cp ~/.dotfiles/programs/git/gitconfig.local.sample ~/.gitconfig.local

[user]
	name = mackay
	email = 43330841+Hiro-mackay@users.noreply.github.com

# --- Optional examples -------------------------------------------------------

# Another account for the repositories under a directory. Put the account in its
# own untracked file next to this one:
#
# [includeIf "gitdir:~/Repository/github.com/<org>/"]
# 	path = ~/.gitconfig.<org>
#
# ~/.gitconfig.<org>:
# [user]
# 	name = <name>
# 	email = <email>

# Strings the dotfiles repo must never contain (its pre-commit hook rejects them),
# e.g. a work email domain or an organization name. One pattern per line:
#
# [secrets]
# 	patterns = <org-name>
# 	patterns = @<work-domain>

# Sign commits with an SSH key:
#
# [gpg]
# 	format = ssh
# [user]
# 	signingkey = ~/.ssh/id_ed25519.pub
# [commit]
# 	gpgsign = true

# Use SSH instead of HTTPS for GitHub remotes:
#
# [url "git@github.com:"]
# 	insteadOf = https://github.com/
