#!/usr/bin/env bash
# Give every running background Claude session a tab, so the sidebar lists what Claude
# runs no matter where the session was started. Sessions that sleep or are deleted
# close their own tab (herdr-claude-tab). Runs until killed.
set -uo pipefail
here=$(dirname "$0")
while sleep 5; do
  agents=$(herdr agent list 2>/dev/null) || continue
  shown=$(jq -r '.result.agents[].tokens.session // empty' <<<"$agents") || continue
  claude agents --json 2>/dev/null | jq -r '.[] | select(.kind == "background" and .pid) | "\(.id) \(.pid)"' |
    while read -r id pid; do
      kill -0 "$pid" 2>/dev/null || continue
      grep -qx "$id" <<<"$shown" || "$here/herdr-claude-open" "$id" --no-focus >/dev/null
    done
done
