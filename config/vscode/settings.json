{
  "workbench.colorTheme": "Dark+",
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 3000,
  "workbench.panel.defaultLocation": "right",
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "workbench.iconTheme": "vscode-great-icons",
  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": false,
  // エディタ・フォーマット関連
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.lineNumbers": "on",
  "editor.minimap.enabled": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.indentSize": "tabSize",
  "editor.inlineSuggest.enabled": true,
  "editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?",
  // 言語固有の設定
  "html.format.wrapLineLength": 0,
  "html.format.enable": false,
  "html.format.indentInnerHtml": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "[rust]": {
    "editor.defaultFormatter": "matklad.rust-analyzer"
  },
  "[go]": {
    "editor.insertSpaces": true,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "golang.go"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[python]": {
    "editor.wordBasedSuggestions": "matchingDocuments",
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "ms-python.python",
    "editor.formatOnType": true
  },
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma"
  },
  // 拡張機能・その他システム設定
  "redhat.telemetry.enabled": true,
  "go.toolsManagement.autoUpdate": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "security.promptForLocalFileProtocolHandling": false,
  // GitLens / AI関連
  "gitlens.advanced.messages": {
    "suppressGitVersionWarning": true
  },
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:oswe-vscode-modelD",
  "chat.viewSessions.orientation": "stacked",
  "workbench.browser.enableChatTools": false,
  "workbench.commandPalette.showAskInChat": false,
  "chat.agent.enabled": false,
  "markdown-preview-enhanced.previewTheme": "vscode.css",
  "chat.disableAIFeatures": true,
  // Git軽量化・最適化設定（レコメンド追加）
  "git.confirmSync": false,
  "git.autofetch": false,
  "git.detectSubmodules": true,
  "git.statusLimit": 5000,
  // ファイル変更監視の除外設定（末尾カンマ修正＋言語キャッシュ追加）
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/target/**": true,
    "**/.venv/**": true,
    "**/.pytest_cache/**": true,
    "**/coverage/**": true,
    "**/.aws-sam/**": true,
    "**/.next/**": true,
    "**/.pnpm/**": true,
    "**/pnpm-lock.yaml": true,
    "**/cdk.out/**": true
  },
  // ファイル検索の除外設定（末尾カンマ修正＋言語キャッシュ追加）
  "search.exclude": {
    "**/.git/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/target/**": true,
    "**/.venv/**": true,
    "**/.pytest_cache/**": true,
    "**/coverage/**": true,
    "**/.aws-sam/**": true,
    "**/.next/**": true,
    "**/.pnpm/**": true,
    "**/pnpm-lock.yaml": true,
    "**/cdk.out/**": true
  }
}
