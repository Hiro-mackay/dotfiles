cask "codex"
cask "cursor"
cask "deepl"
cask "discord"
cask "docker-desktop"
cask "google-chrome"
cask "karabiner-elements"
cask "notion"
cask "slack"
cask "spotify"
cask "visual-studio-code"
cask "warp"
cask "zoom"
