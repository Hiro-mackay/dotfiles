{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NEW_INIT": "true",
    "VAULT_DIR": "/mnt/sdcard/ObsidianVault",
    "VAULT_HOST": "android",
    "VAULT_CLAUDE": "/root/.local/bin/claude",
    "VAULT_DAILY_EVERY": "7",
    "VAULT_DOTFILES": "/root/dotfiles"
  },
  "language": "ja",
  "advisorModel": "fable",
  "tui": "fullscreen",
  "theme": "dark-daltonized",
  "skipWorkflowUsageWarning": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /root/dotfiles/programs/claude/vault-capture.py start",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /root/dotfiles/programs/claude/vault-capture.py end",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
